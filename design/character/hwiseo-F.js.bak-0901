// ── 휘서 F — 네모 양초 캐릭터 (2026-09-01) ──────────────────────────────
// 애니메이션을 전제로 부품을 나눈다. 모든 움직이는 부품에 class 가 있고, transform-origin 은 CSS 에서 잡는다.
//   .hw-glow   불빛 후광            .hw-flame  불꽃 (origin 150,100 = 심지 끝)   .hw-wick 심지 (origin 150,122)
//   .hw-body   몸 전체(왁스·음영)    .hw-eye    눈 (L/R)  .hw-pupil 동공  .hw-lid 눈꺼풀(scaleY 0→1 = 깜빡임)
//   .hw-mouth  입                   .hw-cheek  볼        .hw-sparks 반짝           .hw-shadow 바닥 그림자
// 좌표계 viewBox 0 0 300 340. 몸 x65~235 · y118~300(+물결 밑단 316) · 눈 y205 · 입 y236 · 심지 y92~122 · 불꽃 밑 y100
(function(root){
const C={body:'#FFD54A',wax:'#F2B233',waxDeep:'#E5A128',top:'#FFE9A0',pool:'#FFF3CE',fl:'#FFC12E',fm:'#FFD54A',fi:'#FFF6D6',glow:'#FFE9A0',
         ink:'#2E2418',white:'#FFFBF3',cheek:'#F7A59B',smoke:'#C9C2B8',red:'#FF7A45',pink:'#FF8FA0',tear:'#8FD3F4'};
const FL={
  small:'M150,100 C140,92 138,80 150,66 C162,80 160,92 150,100 Z',
  base:'M150,100 C134,88 130,66 150,40 C170,66 166,88 150,100 Z',
  big:'M150,100 C126,90 116,64 126,42 C132,56 140,62 144,56 C138,40 144,24 150,8 C170,32 174,74 150,100 Z',
  bright:'M150,100 C122,90 108,62 118,36 C124,52 132,58 138,50 C134,34 140,18 150,0 C160,18 166,34 162,50 C168,58 176,52 182,36 C192,62 178,90 150,100 Z',
  spiky:'M150,100 L128,92 L134,70 L122,60 L140,52 L138,30 L150,44 L162,30 L160,52 L178,60 L166,70 L172,92 Z',
  heart:'M150,100 C132,88 122,74 128,60 C132,50 144,50 150,60 C156,50 168,50 172,60 C178,74 168,88 150,100 Z',
};
const LV={0:'off',1:'small',2:'base',3:'big',4:'bright'};
const flameEl=(kind)=>{
  if(kind==='off') return `<g class="hw-flame hw-smoke"><path d="M150,90 c8,-8 -8,-16 2,-26 c6,-6 -2,-12 4,-18" stroke="${C.smoke}" stroke-width="3.5" fill="none" stroke-linecap="round" opacity=".9"/></g>`;
  const d=FL[kind]||FL.base, col=kind==='spiky'?C.red:kind==='heart'?C.pink:C.fl;
  const s=(k)=>`transform="translate(150,100) scale(${k}) translate(-150,-100)"`;
  return `<g class="hw-flame"><path d="${d}" fill="${col}"/><path d="${d}" fill="${C.fm}" ${s(.72)}/><path d="${d}" fill="${C.fi}" ${s(.42)}/></g>`;
};
const glowEl=(level)=> level>=2 ? `<ellipse class="hw-glow" cx="150" cy="${level>=4?60:72}" rx="${level>=4?70:48}" ry="${level>=4?76:54}" fill="${C.glow}" opacity="${level>=4?.42:.3}"/>` : '';
const BODY='M65,152 a34,34 0 0 1 34,-34 h102 a34,34 0 0 1 34,34 v148 a17,17 0 0 1 -34,0 a17,17 0 0 1 -34,0 a17,17 0 0 1 -34,0 a17,17 0 0 1 -34,0 a17,17 0 0 1 -34,0 Z';
const WAXES={
  base:  [[86,148,22,44],[142,148,18,26],[196,148,24,58]],
  left:  [[72,148,30,90],[118,148,18,30],[196,148,22,40]],
  right: [[86,148,20,34],[152,148,18,44],[190,148,32,96]],
  center:[[86,148,20,30],[136,148,30,100],[196,148,22,40]],
  full:  [[70,148,34,120],[112,148,26,90],[150,148,30,130],[194,148,34,110]],
};
let uid=0, LIDS=true;
const bodyEl=(wax='base',view='front')=>{
  const id='hwclip'+(uid++);
  const drips=WAXES[wax].map(([x,y,w,h])=>`<rect x="${x}" y="${y}" width="${w}" height="${h}" rx="${w/2}"/>`).join('');
  const dripHi=WAXES[wax].map(([x,y,w,h])=>`<rect x="${x+4}" y="${y+6}" width="${Math.max(4,w*.28)}" height="${h*.55}" rx="${w*.14}"/>`).join('');
  const sx=view==='side'?.62:view==='q'?.88:1;
  const puddle = wax==='full' ? `<ellipse cx="150" cy="306" rx="100" ry="14" fill="${C.wax}"/>` : '';
  return `<g class="hw-body" transform="translate(150,0) scale(${sx},1) translate(-150,0)">
    ${puddle}
    <defs><clipPath id="${id}"><path d="${BODY}"/></clipPath></defs>
    <path class="hw-bodyfill" d="${BODY}" fill="${C.body}"/>
    <g clip-path="url(#${id})">
      <rect x="198" y="118" width="40" height="220" fill="${C.wax}" opacity=".22"/>          <!-- 오른쪽 음영 -->
      <rect x="76" y="170" width="12" height="110" rx="6" fill="${C.top}" opacity=".7"/>     <!-- 왼쪽 하이라이트 -->
      <rect x="60" y="284" width="180" height="40" fill="${C.wax}" opacity=".16"/>           <!-- 밑단 음영 -->
      <g class="hw-drips" fill="${C.wax}"><rect x="50" y="118" width="200" height="36"/>${drips}</g>
      <g fill="${C.top}" opacity=".45">${dripHi}</g>
    </g>
    <ellipse class="hw-top" cx="150" cy="130" rx="74" ry="12" fill="${C.top}"/>
    <ellipse cx="150" cy="130" rx="58" ry="7.5" fill="${C.pool}" opacity=".8"/>
  </g>`;
};
const wickEl=()=>`<path class="hw-wick" d="M150,124 c-3,-9 3,-15 0,-30" stroke="${C.ink}" stroke-width="10" fill="none" stroke-linecap="round"/>`;
function faceEl(mood,view){
  if(view==='back') return '';
  const one=view==='side', L=one?150:118, R=182, Y=205, MX=150, MY=236;
  const xs=one?[L]:[L,R];
  const st=`stroke="${C.ink}" stroke-width="4.5" fill="none" stroke-linecap="round"`;
  const eye=(x,side,dx=0,dy=0,r=8)=>`<g class="hw-eye hw-eye-${side}">
      <circle cx="${x}" cy="${Y}" r="17" fill="${C.white}"/>
      <g class="hw-pupil"><circle cx="${x+dx}" cy="${Y+dy}" r="${r}" fill="${C.ink}"/><circle cx="${x+dx+3}" cy="${Y+dy-3}" r="2.6" fill="#fff"/></g>
      ${LIDS?`<rect class="hw-lid" x="${x-18}" y="${Y-18}" width="36" height="36" rx="18" fill="${C.body}" transform="translate(${x-18},${Y-18}) scale(1,0) translate(${-(x-18)},${-(Y-18)})"/>`:''}
    </g>`;
  const eyes=(dx,dy,r)=>xs.map((x,i)=>eye(x,i?'r':'l',dx,dy,r)).join('');
  const happyEye=(x)=>`<path d="M${x-12},${Y+3} q12,-16 24,0" stroke="${C.ink}" stroke-width="5" fill="none" stroke-linecap="round"/>`;
  const sleepEye=(x)=>`<path d="M${x-12},${Y-2} q12,12 24,0" stroke="${C.ink}" stroke-width="5" fill="none" stroke-linecap="round"/>`;
  const crossEye=(x)=>`<path d="M${x-9},${Y-8} l18,16 M${x+9},${Y-8} l-18,16" stroke="${C.ink}" stroke-width="5" fill="none" stroke-linecap="round"/>`;
  const wrap=(k)=>`<g class="hw-eyes">${k}</g>`;
  const mouth=(d,fill)=>`<path class="hw-mouth" d="${d}" ${fill?`fill="${C.ink}"`:st}/>`;
  const cheeks=(op=1)=>`<g class="hw-cheek" opacity="${op}"><circle cx="${L-24}" cy="${Y+18}" r="8" fill="${C.cheek}"/>${one?'':`<circle cx="${R+24}" cy="${Y+18}" r="8" fill="${C.cheek}"/>`}</g>`;
  switch(mood){
    case 'happy': return wrap(xs.map(happyEye).join(''))+cheeks(.7)+mouth(`M${MX-14},${MY-2} q14,14 28,0`);
    case 'sad': return wrap(eyes(0,4,8))+mouth(`M${MX-12},${MY+6} q12,-10 24,0`)+`<path class="hw-tear" d="M${L+20},${Y+12} q-6,14 0,20 q6,-6 0,-20 Z" fill="${C.tear}"/>`;
    case 'angry': return wrap(xs.map(crossEye).join(''))+mouth(`M${MX-12},${MY+6} q12,-10 24,0`);
    case 'confused': return wrap(eye(L,'l')+(one?'':`<path d="M${R-12},${Y} q12,-6 24,0" stroke="${C.ink}" stroke-width="5" fill="none" stroke-linecap="round"/>`))+mouth(`M${MX-12},${MY} q6,-8 12,0 q6,8 12,0`);
    case 'surprised': return wrap(eyes(0,0,10))+mouth(`M${MX-7},${MY+3} a7,9 0 1 0 14,0 a7,9 0 1 0 -14,0 Z`,true);
    case 'sleepy': return wrap(xs.map(sleepEye).join(''))+mouth(`M${MX-8},${MY+2} q8,5 16,0`)+`<g class="hw-zzz" fill="${C.ink}" font-family="Pretendard,sans-serif" font-weight="800"><text x="${R+22}" y="${Y-30}" font-size="18">z</text><text x="${R+34}" y="${Y-44}" font-size="14">z</text></g>`;
    case 'shy': return cheeks(1)+wrap(eyes(0,2,8))+mouth(`M${MX-8},${MY+1} q8,7 16,0`);
    case 'excited': return wrap(xs.map(x=>`<path d="M${x-10},${Y-8} l10,8 l-10,8 M${x+10},${Y-8} l-10,8 l10,8" stroke="${C.ink}" stroke-width="5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`).join(''))+cheeks(.8)+mouth(`M${MX-14},${MY-4} q14,18 28,0 z`,true);
    default: return wrap(eyes(0,0,8))+cheeks(.55)+mouth(`M${MX-12},${MY} q12,11 24,0`);
  }
}
const SPARKS=`<g class="hw-sparks" stroke="${C.body}" stroke-width="6" stroke-linecap="round" fill="none"><path d="M40,96 l14,10"/><path d="M34,130 l16,2"/><path d="M260,96 l-14,10"/><path d="M266,130 l-16,2"/></g>`;
function char({level=3,mood='neutral',view='front',flame=null,wax='base',spark=false,vb='0 0 300 340',cls='',lids=true}={}){
  LIDS=lids;
  const f = flame || LV[level];
  if(level===0 && mood==='neutral') mood='sleepy';
  return `<svg class="hw ${cls}" viewBox="${vb}" xmlns="http://www.w3.org/2000/svg" data-level="${level}" data-mood="${mood}">
    <ellipse class="hw-shadow" cx="150" cy="318" rx="88" ry="9" fill="${C.ink}" opacity=".10"/>
    ${f!=='off'?glowEl(level):''}
    ${spark||level===4?SPARKS:''}
    ${bodyEl(wax,view)}
    ${wickEl()}
    ${view==='back'?flameEl(f):''}
    ${view!=='back'?flameEl(f):''}
    ${faceEl(mood,view)}
  </svg>`;
}
// 애니메이션 CSS — 앱에서도 이 블록을 그대로 쓴다
const CSS=`
.hw *{transform-box:view-box}
.hw .hw-flame{transform-origin:150px 100px;animation:hwFlicker 1.7s ease-in-out infinite}
.hw .hw-glow{transform-origin:150px 100px;animation:hwGlow 1.7s ease-in-out infinite;mix-blend-mode:screen}   /* 어두운 배경에서 빛이 더해지듯 */
.hw .hw-smoke{animation:hwSmoke 2.4s ease-in-out infinite}
.hw .hw-body,.hw .hw-wick,.hw .hw-eyes,.hw .hw-mouth,.hw .hw-cheek,.hw .hw-tear,.hw .hw-zzz{transform-origin:150px 316px}
.hw.hw-live .hw-body,.hw.hw-live .hw-wick,.hw.hw-live .hw-eyes,.hw.hw-live .hw-mouth,.hw.hw-live .hw-cheek,.hw.hw-live .hw-flame-wrap{animation:hwBreathe 3.4s ease-in-out infinite}
.hw .hw-lid{transform-origin:center top;transform:scaleY(0);transition:transform .07s ease-in}
.hw.hw-blink .hw-lid{transform:scaleY(1)}
.hw .hw-pupil{transition:transform .12s ease-out}
.hw.hw-bounce{animation:hwBounce .55s cubic-bezier(.3,1.6,.4,1) both;transform-origin:150px 316px}
.hw.hw-sway .hw-wick{animation:hwSway 1.2s ease-in-out infinite;transform-origin:150px 124px}
.hw.hw-sway .hw-flame{animation:hwSway 1.2s ease-in-out infinite,hwFlicker 1.7s ease-in-out infinite;transform-origin:150px 124px}
.hw .hw-sparks{transform-origin:150px 120px;animation:hwSparks 1.4s ease-out infinite}
@keyframes hwFlicker{0%,100%{transform:scale(1,1) rotate(0)}30%{transform:scale(1.06,.94) rotate(-4deg)}60%{transform:scale(.95,1.06) rotate(3deg)}80%{transform:scale(1.03,.98) rotate(-1deg)}}
@keyframes hwGlow{0%,100%{transform:scale(1);opacity:.3}50%{transform:scale(1.08);opacity:.38}}
@keyframes hwSmoke{0%{transform:translateY(0);opacity:.9}100%{transform:translateY(-14px);opacity:0}}
@keyframes hwBreathe{0%,100%{transform:scaleY(1)}50%{transform:scaleY(1.022)}}
@keyframes hwBounce{0%{transform:scale(1,1)}25%{transform:scale(1.12,.86)}50%{transform:scale(.94,1.08)}75%{transform:scale(1.03,.97)}100%{transform:scale(1,1)}}
@keyframes hwSway{0%,100%{transform:rotate(-8deg)}50%{transform:rotate(8deg)}}
@keyframes hwSparks{0%{transform:scale(.7);opacity:0}30%{opacity:1}100%{transform:scale(1.15);opacity:0}}
@media (prefers-reduced-motion:reduce){.hw *{animation:none!important}}
`;
const HWF={char,CSS,C,FL,LV,parts:{flameEl,bodyEl,wickEl,faceEl}};
if(typeof module!=='undefined') module.exports=HWF; else root.HWF=HWF;
})(typeof window!=='undefined'?window:globalThis);

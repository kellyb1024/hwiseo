{
  "rewrites": [
    {
      "source": "/",
      "destination": "/Hwiseo Exhibition.dc.html"
    },
    {
      "source": "/up",
      "destination": "/Hwiseo Upload.dc.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}